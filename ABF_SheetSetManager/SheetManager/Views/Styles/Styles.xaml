<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:hc="https://handyorg.github.io/handycontrol"
                    xmlns:System="clr-namespace:System;assembly=mscorlib"
                    xmlns:local="clr-namespace:SheetSetManager.SheetManager.Views"
                    xmlns:Enums="clr-namespace:SheetSetManager.SheetManager.Enums"                  
                    >

    <ObjectDataProvider x:Key="sequenceValues"
                MethodName="GetValues"
                ObjectType="{x:Type System:Enum}">
        <ObjectDataProvider.MethodParameters>
            <x:Type TypeName="Enums:RevisionSequence"/>
        </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>

    <BooleanToVisibilityConverter x:Key="btvc"/>

    <!-- Window & Background -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="#3b4453"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- General Text Styling -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- DataGrid Styling -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="#3b4453"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="AlternatingRowBackground" Value="#323b49"/>
        <Setter Property="RowBackground" Value="#3b4453"/>
        <Setter Property="BorderBrush" Value="White"/>
    </Style>

    <!-- DataGrid Column Headers -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#323b49"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="BorderBrush" Value="White"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <!-- DataGrid Rows -->
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="#3b4453"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="White"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>

        <Style.Triggers>
            <!-- Change background if the checkbox (IsSelected) is checked -->
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="#556677"/>
                <!-- Custom checked row color -->
            </DataTrigger>

            <!-- Ensure the selection color overrides the checked color -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#2A75B3"/>
                <!-- Default selection color -->
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>

    </Style>

    <!-- DataGrid Row Header -->
    <Style TargetType="DataGridRowHeader">
        <Setter Property="Background" Value="#3b4453"/>
        <!-- Match DataGrid Background -->
        <Setter Property="BorderBrush" Value="#3b4453"/>
        <!-- Match the border -->
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Width" Value="20"/>
        <!-- Adjust width if needed -->
    </Style>

    <!-- Buttons -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="#323b49"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="5,2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="3"/>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#465264"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#2a3242"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- CheckBox Styling -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="#3b4453"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style TargetType="Thumb">
        <Setter Property="Background" Value="#465264"/>
    </Style>

    <Style TargetType="RepeatButton">
        <Setter Property="Background" Value="#3b4453"/>
    </Style>

    <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="#3b4453"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding"    Value="4,2"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#465264"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#2A75B3"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type hc:ComboBox}">
        <Setter Property="Background"       Value="#3b4453"/>
        <Setter Property="Foreground"       Value="White"/>
        <Setter Property="BorderBrush"      Value="White"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="ItemContainerStyle"
            Value="{StaticResource DarkComboBoxItemStyle}"/>
    </Style>
</ResourceDictionary>