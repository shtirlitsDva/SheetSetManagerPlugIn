<hc:Window x:Class="SheetSetManager.SheetManager.Views.ApplyConfirmationWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="Confirm Apply" SizeToContent="WidthAndHeight"
           WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <hc:Window.Resources>
        <ResourceDictionary Source="Styles/Styles.xaml"/>
    </hc:Window.Resources>

    <Grid Margin="24">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="280">
            <TextBlock Text="Apply all pending changes?"
                       FontSize="16"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0 0 0 16"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Cancel" Width="110" Margin="0 0 12 0"
                        Click="Cancel_Click"/>
                <Button Content="Apply"  Width="110"
                        Click="Apply_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</hc:Window>