<hc:Window x:Class="SheetSetManager.SheetManager.Views.SheetManagerWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:SheetSetManager.SheetManager.Views"      
        mc:Ignorable="d"
        Title="Sheet Manager" Height="600" Width="900"
        >

    <hc:Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="EditableCellStyle" TargetType="DataGridCell">
                <EventSetter Event="PreviewMouseRightButtonDown"
                 Handler="Cell_RightClickSelect"/>
                <Setter Property="ContextMenu">
                    <Setter.Value>
                        <ContextMenu>
                            <MenuItem Header="_Edit"
                          Command="{x:Static DataGrid.BeginEditCommand}"
                          CommandTarget="{Binding
                              RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                        </ContextMenu>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- grid style only applies the cell style -->
            <Style x:Key="ManagedDataGridStyle"
       TargetType="DataGrid"
       BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="CellStyle"
            Value="{StaticResource EditableCellStyle}"/>
            </Style>
        </ResourceDictionary>
    </hc:Window.Resources>

    <!-- Custom Title Bar -->
    <hc:Window.NonClientAreaContent>
        <DockPanel Background="{x:Null}" Height="Auto">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="R+" Command="{Binding AddRevisionToSelectedCommand}"
                        Margin="5" Padding="5,2"
                        Background="#465264" Foreground="White"/>
                <Button Content="R-" Command="{Binding RemoveRevisionFromSelectedCommand}"
                        Margin="5" Padding="5,2"
                        Background="#465264" Foreground="White"/>
                <Button Content="Reset" Command="{Binding ResetSheetsCommand}" 
                        Margin="5" Padding="5,2"
                        Background="#465264" Foreground="White"/>
                <Button Content="Apply" Command="{Binding ApplyChangesCommand}" 
                        Margin="5" Padding="5,2"
                        Background="#465264" Foreground="White"
                        Visibility="{Binding HasPendingChanges, 
                    Converter={StaticResource btvc}}"/>
            </StackPanel>
        </DockPanel>
    </hc:Window.NonClientAreaContent>

    <Grid>
        <DataGrid ItemsSource="{Binding Sheets}" SelectedItem="{Binding Sheets.SelectedSheet}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="False" 
                  PreviewKeyDown="DataGrid_PreviewKeyDown"
                  CellEditEnding="DataGrid_CellEditEnding"
                  BeginningEdit="Grid_BeginningEdit"
                  Sorting="DataGrid_Sorting"
                  RowStyle="{StaticResource {x:Type DataGridRow}}"
                  Style="{StaticResource ManagedDataGridStyle}"
                  >
            <DataGrid.Columns>
                <!-- Checkbox for selection -->
                <DataGridTemplateColumn Width="40">
                    <!-- Header Checkbox: Clicks select/deselect all -->
                    <DataGridTemplateColumn.Header>
                        <CheckBox x:Name="SelectAllCheckBox"
                  Click="SelectAllCheckBox_Click"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"/>
                    </DataGridTemplateColumn.Header>

                    <!-- Row Checkbox: Prevents row expansion -->
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, 
                                UpdateSourceTrigger=PropertyChanged}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      PreviewMouseDown="CheckBox_PreviewMouseDown"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Sheet General Information -->
                <local:CustomTextColumn Binding="{Binding Properties.SheetNumber.Value,
                    Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                    Header="Sheet #" Width="150"
                    TagPath="Number"/>
                <local:CustomTextColumn Binding="{Binding Properties.Date.Value,
                    Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Header="Date" Width="100"
                    TagPath="Dato"/>
                <local:CustomTextColumn Binding="{Binding Properties.Title1.Value,
                    Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Header="Title 1" Width="150"
                    TagPath="Emnelinje 1"/>
                <local:CustomTextColumn Binding="{Binding Properties.Title2.Value,
                    Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Header="Title 2" Width="150"
                    TagPath="Emnelinje 2"/>
                <local:CustomTextColumn Binding="{Binding Properties.ApprovedBy.Value,
                    Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Header="Approved By" Width="80"
                    TagPath="Godkendt"/>
                <local:CustomTextColumn Binding="{Binding Properties.CheckedBy.Value,
                    Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Header="Checked By" Width="80"
                    TagPath="Kontrol"/>
                <local:CustomTextColumn Binding="{Binding Properties.DrawnBy.Value,
                    Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Header="Drawn By" Width="80"
                    TagPath="1 Tegner"/>
                <local:CustomTextColumn Binding="{Binding Properties.Scale.Value,
                    Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Header="Scale" Width="80"
                    TagPath="Målestok ex 1:50"/>

                <!-- Latest Revision Information -->
                <DataGridTextColumn Binding="{Binding Revisions.LatestRevision.RevisionLetter.Value}"
                                    Header="Rev #" Width="50" IsReadOnly="True"/>
                <DataGridTextColumn Binding="{Binding Revisions.LatestRevision.Date.Value}"
                                    Header="Rev Date" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Binding="{Binding Revisions.LatestRevision.Description.Value}"
                                    Header="Rev Description" Width="300" IsReadOnly="True"/>
            </DataGrid.Columns>

            <!-- Row Details: Expand to show all revisions -->
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" Padding="5">
                        <StackPanel>
                            <TextBlock Text="All Revisions:" FontWeight="Bold"/>
                            <DataGrid ItemsSource="{Binding Revisions}"
                                      AutoGenerateColumns="False" 
                                      CanUserAddRows="False"
                                      PreviewKeyDown="DataGrid_PreviewKeyDown"
                                      CellEditEnding="DataGrid_CellEditEnding"
                                      BeginningEdit="Grid_BeginningEdit"
                                      Style="{StaticResource ManagedDataGridStyle}"
                                      >
                                <DataGrid.Columns>
                                    <local:CustomTextColumn Binding="{Binding RevisionLetter.Value,
                                        Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Header="Rev #" Width="50"
                                        TagPath="Rev"/>
                                    <local:CustomTextColumn Binding="{Binding Date.Value,
                                        Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Header="Date" Width="100"
                                        TagPath="Dato"/>
                                    <local:CustomTextColumn Binding="{Binding Description.Value,
                                        Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Header="Description" Width="300"
                                        TagPath="Emne"/>
                                    <local:CustomTextColumn Binding="{Binding ApprovedBy.Value,
                                        Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Header="Approved By" Width="100"
                                        TagPath="Godkendt"/>
                                    <local:CustomTextColumn Binding="{Binding CheckedBy.Value,
                                        Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Header="Checked By" Width="100"
                                        TagPath="Kontrol"/>
                                    <local:CustomTextColumn Binding="{Binding DrawnBy.Value,
                                        Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Header="Drawn By" Width="100"
                                        TagPath="Tegner"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>

        </DataGrid>
    </Grid>
</hc:Window>
